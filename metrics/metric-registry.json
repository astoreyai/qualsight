  "metrics": [
    {
      "metric_id": "biometric.verification.fmr",
      "definition_version": "1.0.0",
      "canonical_name": "False Match Rate",
      "aliases": ["FMR"],
      "domain": "VERIFICATION",
      "metric_type": "RATE",
      "definition": "The proportion of included non-mated comparison trials for which the recorded matcher decision is accept at a specified matcher threshold.",
      "formula": {
        "kind": "RATE",
        "formula_version": "1.0.0",
        "numerator_population": "NON_MATED",
        "numerator_event": "ACCEPT",
        "denominator_population": "INCLUDED_NON_MATED_TRIALS",
        "denominator_policy": "RECORDED_FAILURE_POLICY"
      },
      "higher_or_lower_is_better": "LOWER",
      "required_inputs": [
        "comparison_ground_truth",
        "matcher_decision",
        "matcher_threshold",
        "score_direction",
        "threshold_equality_rule",
        "processing_failure_policy"
      ],
      "aggregation_unit": "NON_MATED_COMPARISON_TRIAL",
      "threshold_semantics": {
        "threshold_kind": "MATCHER_THRESHOLD",
        "decision_rule_source": "RECORDED_PROTOCOL",
        "score_direction_required": true,
        "equality_rule_required": true,
        "threshold_reestimation": "NOT_APPLICABLE"
      },
      "confidence_interval_methods": [
        "BINOMIAL_WHEN_INDEPENDENCE_IS_JUSTIFIED",
        "SUBJECT_AWARE_BOOTSTRAP"
      ],
      "source_standard": "QUALSIGHT_PRD",
      "source_version": "0.3",
      "references": [
        {"source_id": "prd-0.3", "locator": "PRD.md:577-578"},
        {"source_id": "requirements-0.2", "locator": "REQUIREMENTS.md:54-55"},
        {"source_id": "requirements-0.2", "locator": "REQUIREMENTS.md:58"},
        {"source_id": "requirements-0.2", "locator": "REQUIREMENTS.md:64"},
        {"source_id": "requirements-0.2", "locator": "REQUIREMENTS.md:70"}
      ],
      "source_requirements": ["QS-REQ-015", "QS-REQ-016", "QS-REQ-018", "QS-REQ-024", "QS-REQ-029"],
      "implementation": {
        "kind": "DEFINITION_ONLY",
        "artifact": "metrics/metric-registry.json"
      },
      "implementation_version": "1.0.0",
      "limitations": [
        "This definition does not select a matcher threshold or assert independence among reused samples or subjects."
      ],
      "warnings": [
        "Processing failures must follow the recorded inclusion policy and must not silently disappear from the denominator."
      ]
    },
